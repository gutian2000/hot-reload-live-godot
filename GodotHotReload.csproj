<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableAOTCaching>true</EnableAOTCaching>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
  <!-- 热更由游戏进程内的 HotReloadRuntime 负责；不编译已停用的旧编辑器插件。 -->
  <ItemGroup>
    <Compile Remove="addons\**\*.cs" />
  </ItemGroup>
  <!-- 自动把 0Harmony.dll 复制到 Godot 编译输出目录 -->
  <Target Name="CopyHarmony" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)lib.harmony\2.4.2\lib\net8.0\0Harmony.dll"
          DestinationFolder="$(ProjectDir).godot\mono\temp\bin\Debug\" SkipUnchangedFiles="true" />
  </Target>
</Project>
