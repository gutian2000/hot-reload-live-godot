<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableAOTCaching>true</EnableAOTCaching>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.2" />
  </ItemGroup>
  <!-- Editor plugin lives in addons/ — excluded from compilation (runs in editor process) -->
  <ItemGroup>
    <Compile Remove="addons\**\*.cs" />
  </ItemGroup>
  <!-- Dev-only spike tests — excluded from Godot project compilation -->
  <ItemGroup>
    <Compile Remove="spike\**\*.cs" />
    <Compile Remove="spike2\**\*.cs" />
  </ItemGroup>
  <!-- Auto-copy 0Harmony.dll to Godot's build output -->
  <Target Name="CopyHarmony" AfterTargets="Build">
    <Copy SourceFiles="$(NuGetPackageRoot)lib.harmony\2.4.2\lib\net8.0\0Harmony.dll"
          DestinationFolder="$(ProjectDir).godot\mono\temp\bin\Debug\" SkipUnchangedFiles="true" />
  </Target>
</Project>
